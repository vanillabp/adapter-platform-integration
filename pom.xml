<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.2.1</version>
  </parent>

  <artifactId>adapter-platform-integration</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP adapter platform integration</name>
  <description>Platform integrations for the VanillaBP SPI: the platform-neutral migration adapter plus its Spring Boot and Quarkus integrations.</description>
  <url>https://www.vanillabp.io</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>bom</module>
    <module>build-tools/mapstruct-fluent-accessors</module>
    <module>test-utils</module>
    <module>schema</module>
    <module>migration-adapter</module>
    <!-- before the two platform integrations, although it builds against both: an
         extension's deployment half is not a dependency of the application using it, so
         nothing orders it against the applications which need it at build time and the
         reactor falls back to this list -->
    <module>bpms-double</module>
    <module>spring-boot-integration</module>
    <module>quarkus-integration</module>
    <module>test-coverage-report</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/vanillabp/adapter-platform-integration.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/adapter-platform-integration.git</developerConnection>
    <url>http://github.com/vanillabp/adapter-platform-integration/tree/main</url>
  </scm>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/adapter-platform-integration</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Keep in sync with the property 'spi-for-java.version' of bom/pom.xml. -->
    <vanillabp.version>2.0.0-SNAPSHOT</vanillabp.version>
    <!-- The oldest BPMS adapter and the oldest extension this platform integration still
         serves. Set it deliberately with every release: raising it stops the boot of every
         application still using an older part (see decision 71 in DECISIONS.md). -->
    <vanillabp.oldest-part.version>2.0.0</vanillabp.oldest-part.version>
    <!-- The Java version of the published class files, which is what an application
         needs to run them. It is not the JDK the build runs on: the workflows under
         .github/workflows build with a newer one and compile against this release, so an
         application on Java 21 keeps working. Raising this number shuts such an
         application out, so raise it deliberately and say so in UPGRADE.md. -->
    <version.java>21</version.java>
    <!-- the platform versions live here because two trees build against them: the two
         platform integrations and the BPMS double, which is a module tree of its own -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <quarkus.version>3.39.3</quarkus.version>
    <lombok.version>1.18.48</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <transaction-outbox.version>7.1.750</transaction-outbox.version>
    <jacoco.version>0.8.15</jacoco.version>
    <mockito.version>5.23.0</mockito.version>
    <!-- optional: metrics of the election cache are published if the application
         brings Micrometer; compiled against the OLDER of both platforms (Quarkus
         3.37.1 manages 1.16.6, Spring Boot 4.1.0 manages 1.17.0) -->
    <micrometer.version>1.17.1</micrometer.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- Liquibase reads the changelog of the schema artifact: in the schema module, which
         also generates the SQL with it, and in the reader of that changelog in test-utils -->
    <liquibase.version>5.0.4</liquibase.version>
    <!-- where the build breaks, in PERCENT of covered instructions per platform,
         enforced by test-coverage-report/coverage-gate. The rule stays 90 per platform, which is
         the number the coverage badges of the README are read against. The gate stands at
         85, the same number in every VanillaBP repository, because a threshold marks the
         point where somebody has to look and not the goal to aim at. It is never raised to whatever a
         suite happens to reach, and never lowered to make a build pass. -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- the rule, as a number the gate can print: it reports every run against both, so
         the distance between a passing build and the rule is readable without opening
         the report -->
    <coverage.rule>90</coverage.rule>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>spi-for-java</artifactId>
        <version>${vanillabp.version}</version>
      </dependency>
      <dependency>
        <!-- 'provided' here and again at every single declaration: Lombok translates the
             source and has no work left once the class file exists, so no application
             using our artifacts may find it on its runtime classpath. Writing 'optional'
             here did not do that. Maven copies a managed version, scope and exclusions
             into a dependency, but not the optional flag, so the POMs we publish said
             nothing and an application whose own BOM names Lombok, which both platform
             BOMs do, resolved it at compile scope. -->
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.19</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-core</artifactId>
        <version>${micrometer.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-mongodb</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <!-- a message about a parameter names it the way the developer wrote it, and
                 without this flag javac replaces that name with arg0, arg1 and so on.
                 It is the application's own build which decides what its handler methods
                 report, and spring-boot-starter-parent sets the flag there; this one is
                 what makes the tests of this repository read like such an application. -->
            <parameters>true</parameters>
            <compilerArgs>
              <!-- a javadoc which names a method is checked like any other claim: a link
                   the compiler cannot resolve, a tag which no longer exists in HTML or a
                   heading out of order stops the build. javac is the half of the check
                   which sees a package private class; the javadoc plugin only opens what
                   the published documentation shows. 'missing' is the one group left out,
                   because a comment nobody has written yet is a warning we live with. -->
              <arg>-Xdoclint:all,-missing</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- a time zone, for the reason the surefire configuration below gives one -->
            <argLine>-Duser.timezone=Europe/Vienna</argLine>
            <!-- deterministic order: the default 'filesystem' differs between a
                 developer machine and the GitHub runner, which hid an order-dependent
                 test for a day -->
            <runOrder>alphabetical</runOrder>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- see https://javadoc.io/doc/org.mockito/mockito-core/latest/org.mockito/org/mockito/Mockito.html#mockito-instrumentation -->
            <!-- property 'jacoco.agent' is filled by jacoco-maven-plugin blow in this file -->
            <!-- a time zone, because VanillaBP refuses to start a JVM which stands on UTC
                 without one being configured for the housekeeping of the outbox (decision 91).
                 A GitHub runner stands on UTC, a developer machine usually does not, and a test
                 JVM which is given a zone is a test JVM shaped like the server the application
                 will run on. The refusal itself is tested where it belongs, in
                 HousekeepingWindowConfigurationTest, which asks the properties rather than the
                 JVM. -->
            <argLine>@{jacoco.agent} -Xshare:off -Duser.timezone=Europe/Vienna -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
            <!-- deterministic order, see the failsafe configuration above -->
            <runOrder>alphabetical</runOrder>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.mockito</groupId>
              <artifactId>mockito-core</artifactId>
              <version>${mockito.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
            <!-- a warning fails the build here. What this repository publishes is read by
                 the author of an application, by whoever writes the next BPMS adapter and
                 by whoever writes an extension of the deployment pipeline, so a comment
                 nobody wrote is a gap for a reader with no other source. The gaps here
                 were written once, and a warning which passes parks the next one in a
                 build which looks green. Everything else about the check comes from the
                 parent. -->
            <failOnWarnings>true</failOnWarnings>
            <!-- two kinds of source file in this build are generated, and generated code
                 carries no comments. The Quarkus extension processor writes an accessor
                 class next to every class holding build steps, and MapStruct writes the
                 implementation of a mapper interface, named after it. Both are compiled and
                 neither is written by hand, so they are left out here rather than being the
                 reason a missing comment stays allowed everywhere. -->
            <sourceFileExcludes>
              <sourceFileExclude>**/*$$accessor.java</sourceFileExclude>
              <sourceFileExclude>**/*MapperImpl.java</sourceFileExclude>
            </sourceFileExcludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <eclipse>
              <!-- https://help.eclipse.org/latest/index.jsp?topic=%2Forg.eclipse.jdt.doc.isv%2Freference%2Fapi%2Forg%2Feclipse%2Fjdt%2Fcore%2Fformatter%2FDefaultCodeFormatterConstants.html -->
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <sessionId>anonymous-session-id</sessionId>
          <!-- exclude test classes and main-classes needed by integration tests -->
          <excludes>
            <exclude>io/vanillabp/integration/test/**</exclude>
            <exclude>io/vanillabp/integration/it/**</exclude>
          </excludes>
          <!-- stores javaagent JVM-parameter into property to be used by Quarkus which starts additional JVMs
                      to run integration tests -->
          <propertyName>jacoco.agent</propertyName>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
