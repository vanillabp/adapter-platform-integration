<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.quarkus.extension</groupId>
    <artifactId>sample-extension-parent</artifactId>
    <version>2.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>sample-extension</artifactId>
  <name>Quarkus integration - Sample extension extension</name>

  <!-- The Quarkus half of the extension the Spring Boot integration tests also build:
    the same annotation, the same contract, the same per-aggregate service, wired as a
    Quarkus extension instead of an auto-configuration. Its dependencies are the point of
    it. It sees the extension SPI, which brings the integration SPI along, and nothing else
    of VanillaBP: not the platform-neutral core, and not vanillabp-quarkus-integration,
    which is what an extension of version 1 had to inherit its base classes from. The
    enforcer rule below stops the build if one of them arrives, even transitively. -->

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-extension-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-extension-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>extension-descriptor</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <deployment>${project.groupId}:${project.artifactId}-deployment:${project.version}</deployment>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <release>${version.java}</release>
              <annotationProcessorPaths>
                <path>
                  <groupId>io.quarkus</groupId>
                  <artifactId>quarkus-extension-processor</artifactId>
                  <version>${quarkus.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- the rule which keeps this module honest: an extension needs the extension SPI
             and nothing of the core or of a platform integration, not even transitively.
             See decision 149 in the repository's DECISIONS.md for why. -->
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>an-extension-depends-on-the-extension-spi-alone</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.vanillabp.adapter:migration-adapter</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration</exclude>
                  </excludes>
                  <message>An extension depends on io.vanillabp:vanillabp-extension-spi alone. It brings the integration SPI along. Everything an extension reads from VanillaBP is offered there. See migration-adapter/EXTENSION-AUTHORS.md, section 1.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
