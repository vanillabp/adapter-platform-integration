<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- the Quarkus BOM and the settings of the Quarkus plugin come with this parent -->
  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>quarkus-integration-parent</artifactId>
    <version>2.0.1-SNAPSHOT</version>
    <relativePath>../../quarkus-integration/pom.xml</relativePath>
  </parent>

  <groupId>io.vanillabp.loadtest</groupId>
  <artifactId>load-test-quarkus</artifactId>
  <name>Load test - Quarkus</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skip.central.release>true</skip.central.release>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- the smoke test proves the wiring, and no coverage report reads it -->
    <jacoco.skip>true</jacoco.skip>
    <jacoco.agent/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>load-harness</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>bpms-double-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-agroal</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!-- the smoke test runs a tiny round on H2, so the build proves the wiring without a
         container -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- a runnable application under target/quarkus-app: the weekly run starts a fresh
           JVM for every round -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
