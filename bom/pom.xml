<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ATTENTION: The parent is the release parent and NOT 'adapter-platform-integration'
       on purpose. Importing a BOM imports its EFFECTIVE dependencyManagement, which
       includes all entries inherited from its parents. Inheriting from
       'adapter-platform-integration' would therefore silently pin the versions of
       Lombok, SLF4J, Testcontainers, ... in every application importing this BOM. The
       release parent has no dependencyManagement at all. -->
  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.2.1</version>
  </parent>

  <groupId>io.vanillabp</groupId>
  <artifactId>vanillabp-bom</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP BOM</name>
  <description>Aligned versions of all VanillaBP artifacts an application uses. BPMS adapters are NOT part of this BOM - they are released independently and are added as explicit dependencies.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/adapter-platform-integration</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <!-- Keep in sync with the property 'vanillabp.version' of the aggregator pom. The
         BOM cannot inherit it (see the comment on the parent above). -->
    <spi-for-java.version>2.0.0-SNAPSHOT</spi-for-java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- This pom is formatted by the aggregator's Spotless run (it includes
         '**/pom.xml'), but the plugin itself is not inherited here (see the parent
         comment above), so a directly invoked spotless goal has to skip this module. -->
    <spotless.check.skip>true</spotless.check.skip>
    <spotless.apply.skip>true</spotless.apply.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The API used by business code (workflow modules). -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>spi-for-java</artifactId>
        <version>${spi-for-java.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-integration-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Spring Boot integration. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-spring-boot-integration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-spring-boot-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Quarkus integration. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration-deployment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Migration adapter: the runtime plus the SPIs implemented by BPMS adapters and by extensions. -->
      <dependency>
        <groupId>io.vanillabp.adapter</groupId>
        <artifactId>migration-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-extension-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-adapter-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- The tables VanillaBP needs, for an application creating its schema itself. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-schema</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- ATTENTION: every entry below is a tool of the build and has to name its scope
           here. A management entry without a scope promises 'compile'. An application
           which writes down the coordinate and nothing else would then ship the tool to
           its own users. This is the mistake we made with Lombok in the aggregator pom,
           one level higher up: what an application sees of this BOM is what the entry
           says, not what we meant.

           The scope written here means the application which uses the tool. A module
           which is ITSELF a library of test tools has to write its own scope at its
           declaration. A module using 'test-utils' in 'src/main/java' says
           <scope>compile</scope> there, or it inherits 'test' from this BOM and stops
           compiling. That happened in 'business-cockpit' on 2026-09-22 and turned every
           open pull request of that repository red. -->
      <!-- Build-time helper: it teaches MapStruct to read fluent accessors and only runs
           on an annotation-processor path. Nothing calls it once the class files exist. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-mapstruct-fluent-accessors</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- Test helper: the small utilities a VanillaBP test uses to set itself up. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- The BPMS double: an adapter which pretends to be a BPMS, so a test boots an
           application without one. A Spring Boot application adds the one artifact, a
           Quarkus application the extension pair. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>bpms-double</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>bpms-double-spring-boot</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>bpms-double-quarkus</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>bpms-double-quarkus-deployment</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
