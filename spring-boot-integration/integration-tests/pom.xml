<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>spring-boot-integration-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <groupId>io.vanillabp.springboot</groupId>
  <artifactId>integration-tests-parent</artifactId>
  <packaging>pom</packaging>
  <name>Spring Boot integration - Integration tests</name>

  <modules>
    <module>test-applications</module>
    <module>main-integration-test</module>
    <module>workflowmodule-integration-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- configure JaCoCo for all sub-modules -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>prepare-agent-integration</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
              <configuration>
                <excludes>
                  <!-- exclude tests and sample code by explicitly only including code to be tested -->
                  <exclude>io/vanillabp/integration/test</exclude>
                  <exclude>io/vanillabp/integration/it</exclude>
                </excludes>
                <append>true</append>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- run integration tests in every sub-module -->
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
