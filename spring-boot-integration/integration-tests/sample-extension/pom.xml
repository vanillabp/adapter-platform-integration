<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.springboot</groupId>
    <artifactId>integration-tests-parent</artifactId>
    <version>2.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>sample-extension</artifactId>
  <name>Spring Boot integration - Sample extension</name>

  <!-- The extension a Business-Cockpit-shaped extension is built like, in miniature: its
    own annotation invoked through the handler contracts, its own per-aggregate service,
    the election, an outbox operation and its own configuration below
    'vanillabp.extensions.sample'.

    Its dependencies are the point of it. It sees the extension SPI, which brings the
    integration SPI along, and nothing else of VanillaBP. It does not see the
    platform-neutral core, and it does not see 'vanillabp-spring-boot-integration', which is
    what an extension of version 1 had to inherit its base classes from. Adding either
    dependency here would make this module stop proving anything, and the enforcer rule
    below stops the build if one arrives, even transitively. -->

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-extension-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- the rule which keeps this module honest: an extension needs the extension SPI
             and nothing of the core or of a platform integration, not even transitively.
             See decision 149 in the repository's DECISIONS.md for why. -->
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>an-extension-depends-on-the-extension-spi-alone</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.vanillabp.adapter:migration-adapter</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration</exclude>
                  </excludes>
                  <message>An extension depends on io.vanillabp:vanillabp-extension-spi alone. It brings the integration SPI along. Everything an extension reads from VanillaBP is offered there. See migration-adapter/EXTENSION-AUTHORS.md, section 1.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
